using c

cxx.std = latest
using cxx

h{*}: extension = h
c{*}: extension = c
cxx{*}: extension = cc

# Every exe{} in this subproject is by default a test.
#
exe{*}: test = true

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $c.target

if ($build.mode != 'skeleton')
  source build/simd.build
