./: {*/ -build/ -c/}

# Upstream test/c/std programs need the git submodule's test/data.
# Keep them for local testing. The published archive (and the
# post-checkout redist) omit that directory, so only mention it
# when it is present and we are not distributing.
#
if ($build.meta_operation != 'dist' && $directory_exists($src_base/c))
  ./: c/
