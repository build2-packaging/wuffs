: run
:
# testlib walks up to wuffs-root-directory.txt, then reads test/data/.
# Link the src overlay into $~ and drop the marker next to it.
# Trailing slash on the source keeps the directory attribute on Windows.
# $src_root/test is a real directory of per-entry upstream symlinks
# (build2#549).
#
{
  ln -s $src_root/test/ test
  touch wuffs-root-directory.txt
  $* >!
}
